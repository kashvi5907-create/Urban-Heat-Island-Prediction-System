# print(best_r2_score)
# print(best_param)


best_model = xgb.XGBRegressor(
    n_estimators=400,
    max_depth=6,
    learning_rate=0.05,
    subsample=0.9,
    reg_lambda=1,
    reg_alpha=0,
    min_child_weight=1,
    gamma=0,
    colsample_bytree=0.8
)
best_model.fit(X_train,y_train)
y_pred_train = best_model.predict(X_train)
y_pred_test = best_model.predict(X_test)


print(f"RMSE of training data = {root_mean_squared_error(y_train, y_pred_train)}")
print(f"RMSE of testing data = {root_mean_squared_error(y_test, y_pred_test)}")

print(f"r2_score of training data = {r2_score(y_train, y_pred_train)}")
print(f"r2_score of testing data = {r2_score(y_test, y_pred_test)}")
print(f"mean absolute error of testing data = {mean_absolute_error(y_test, y_pred_test)}")


print(best_model.feature_importances_)


importance = pd.DataFrame({
    "Features" : X.columns,
    "Importance" : best_model.feature_importances_
})
importance = importance.sort_values(by="Importance", ascending=False)
importance


# Actual vs Predictedplt

plt.figure(figsize=(6,6))
plt.scatter(y_test, y_pred_test,c="green", alpha=0.2)
plt.plot([y.min(), y.max()], [y.min(), y.max()], 'r--')
plt.xlabel("Actual LST")
plt.ylabel("Predicted LST")
plt.title("Actual vs Predicted LST")
plt.show()





!pip install shap


import shap


explainer = shap.TreeExplainer(best_model)


with open(r"C:\Users\kashv\Desktop\Delhi_UHI_Project\Streamlit\shap_explainer.pkl", "wb") as f:
    pickle.dump(explainer, f)


shap_values = explainer.shap_values(X_test)


shap.summary_plot(shap_values, X_test)


shap.summary_plot(
    shap_values,
    X_test,
    plot_type="bar"
)


sample = 0
shap.plots.waterfall(
    explainer(X_test.iloc[[sample]])[0]
)


shap.dependence_plot(
    "NDBI",
    shap_values,
    X_test
)


with open(r"C:\Users\kashv\Desktop\Delhi_UHI_Project\Streamlit\best_model.pkl", "wb") as f:
    pickle.dump(best_model,f)


