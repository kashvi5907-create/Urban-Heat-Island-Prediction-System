import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
import pandas as pd
from sklearn.impute import SimpleImputer
import numpy as np
from sklearn.preprocessing import LabelEncoder, OneHotEncoder
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import accuracy_score, r2_score, root_mean_squared_error, mean_absolute_error
from sklearn.preprocessing import OneHotEncoder
from sklearn.tree import plot_tree
from sklearn.model_selection import RandomizedSearchCV


df = pd.read_csv(r"C:\Users\kashv\Desktop\Delhi_UHI_Project\Data\Processed\cleaned_dataset.csv")
df.head()
df = df.drop(columns=["LULC"])


# One hot encoding
ohe = OneHotEncoder(drop="first", sparse_output=False, handle_unknown="ignore")
encoded = ohe.fit_transform(df[["LULC_Name"]])

encoded_df = pd.DataFrame(
    encoded,
    columns=ohe.get_feature_names_out(["LULC_Name"]),
    index = df.index
)

df = pd.concat([df.drop(columns=["LULC_Name"]),encoded_df], axis=1)


df.columns


X = df.drop(columns=["LST"])
y = df["LST"]


X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=43
)


rf = RandomForestRegressor(
    random_state=43,
    oob_score=True
)

rf.fit(X_train, y_train)


y_pred_train = rf.predict(X_train)
y_pred_test = rf.predict(X_test)

print(f"oob_score of data = {rf.oob_score_}")

print(f"MSE of training data = {root_mean_squared_error(y_train, y_pred_train)}")
print(f"MSE of testing data = {root_mean_squared_error(y_test, y_pred_test)}")

print(f"r2_score of training data = {r2_score(y_train, y_pred_train)}")
print(f"r2_score of testing data = {r2_score(y_test, y_pred_test)}")





